# Copy this file to .env and fill it in. .env is never committed or logged.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      (openai/gpt-oss-20b is smaller and faster)

# Speaks the replies (and hears the caller if Modulate is not set). Free credit: https://console.deepgram.com
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# Hackathon: Modulate hears the caller. If set, it is used instead of Deepgram for speech to text.
MODULATE_API_KEY=
# STT_PROVIDER=modulate    (or deepgram to force the fallback)

# Web search for background that isn't in our data (optional). Free: 1,000 searches a month at tavily.com
TAVILY_API_KEY=

# Fraud guards. The cloned-voice check is on automatically when MODULATE_API_KEY is set; the social-engineering guard
# is always on. All of these are optional.
# FRAUD_GUARD=off                    turn the cloned-voice check off
# FRAUD_SYNTHETIC_THRESHOLD=0.9      how sure Modulate must be that a window of audio is synthetic (0 to 1)
# FRAUD_SYNTHETIC_WINDOWS=2          how many such windows end the call (one only restricts sensitive answers)
# FRAUD_FAIL_CLOSED=yes              if the cloned-voice check can't run, end the call instead of carrying on

# Output guard (on by default): checks every sentence the AI model writes before it is spoken. Numbers must trace to a tool
# result from this call, and the wording must stay inside the rules. Switch off only to troubleshoot a false alarm.
# OUTPUT_GUARD=off

# The analyst's own phone number(s), comma separated. Only these can use the line.
ALLOWED_CALLERS=+15550100100

# From the Plivo console (Home page). The auth token lets the server check that requests really come from Plivo,
# and with both set the server can hang up the call itself when it ends.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Your public tunnel address without https://, e.g. abc-def.trycloudflare.com
PUBLIC_HOST=

# PORT=8001
